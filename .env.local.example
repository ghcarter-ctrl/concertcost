# Copy this file to .env.local and fill in your values.
# In Supabase: open the ConcertCost project → Connect dialog or Settings → API Keys.
# Copy the Project URL and the publishable key (or the older anon public key).
# Do NOT use the service role / secret key in this frontend app.

NEXT_PUBLIC_SUPABASE_URL=your-project-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key-here
